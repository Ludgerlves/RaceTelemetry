{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.f1telemetry.app",
  "productName": "F1 Telemetry Monitor",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "F1 2025 Telemetry Monitor",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {
    "dialog": null,
    "fs": {
      "all": true
    },
    "shell": {
      "all": true
    }
  }
}